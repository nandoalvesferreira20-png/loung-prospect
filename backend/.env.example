# Local backend. Copy to .env.local at repository root; keep credentials private.
LOUNG_AUTH_MODE=local
LOUNG_STORAGE_BACKEND=sqlite
LOUNG_DATABASE_PATH=data/loung_prospect.db
LOUNG_ENABLE_WRITES=1
GOOGLE_PLACES_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30
# Optional local read integration; empty disables it. Generate a dedicated random token.
LOUNG_SALES_AI_TOKEN=
