# =====================================
# Ambiente Virtual
# =====================================
.venv/
venv/
env/
ENV/
.venv-*/

# =====================================
# Python
# =====================================
__pycache__/
*.py[cod]
*$py.class

# =====================================
# Compilações
# =====================================
build/
dist/
*.egg-info/
.eggs/
# Arquivos .spec são configuração de build e devem poder ser versionados.

# =====================================
# PyInstaller
# =====================================
*.manifest
*.exe

# =====================================
# Logs
# =====================================
logs/
*.log

# =====================================
# Exportações
# =====================================
exports/
*.xlsx
*.csv
# Somente dados sintéticos devem ser colocados nesta pasta.
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.csv
~$*.xlsx

# =====================================
# Configurações Locais
# =====================================
.env
.env.*
!.env.example
!.env.template
config/local.json

# =====================================
# VS Code
# =====================================
.vscode/

# =====================================
# JetBrains
# =====================================
.idea/

# =====================================
# Sistema Operacional
# =====================================
.DS_Store
Thumbs.db
desktop.ini

# =====================================
# Pytest
# =====================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# =====================================
# MyPy
# =====================================
.mypy_cache/

# =====================================
# Ruff
# =====================================
.ruff_cache/

# =====================================
# Playwright
# =====================================
playwright-report/
test-results/

# Navegadores instalados localmente (PLAYWRIGHT_BROWSERS_PATH=0).
.local-browsers/
# Estado autenticado do navegador: pode conter cookies e tokens.
playwright/.auth/

# =====================================
# Arquivos Temporários
# =====================================
temp/
tmp/
*.tmp

# =====================================
# Backups
# =====================================
*.bak
*.old

# Banco local e arquivos auxiliares de transação
data/
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
