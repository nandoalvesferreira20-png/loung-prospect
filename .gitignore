# Python environments and bytecode
.venv/
.venv-*/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Python tests, coverage and analysis
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Next.js, Node and frontend test output
node_modules/
.next/
out/
.npm-cache/
.turbo/
.vercel/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
test-results/
.local-browsers/
playwright/.auth/

# Build/distribution output; source .spec files remain versionable
build/
dist/
*.egg-info/
.eggs/
*.manifest
*.exe

# Private environment and machine configuration
.env
.env.*
*.env
*.env.local
.envrc
.direnv/
!.env.*.example
!.env.*.template
!*.env.example
!*.env.template
*.pem
*.key
*.p12
*.pfx
/config/local.json
.vscode/
.idea/
/.aws/credentials
/.aws/config

# SQLite databases, journals, backups and private dumps
/data/
/backups/
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
*-wal
*-shm
*.bak
*.old
*.dump
*.sql.gz

# Commercial exports and generated prototypes; templates are source
exports/
/output/
/prototypes/
*.csv
*.xlsx
~$*.xlsx

# Explicitly versionable synthetic fixtures (never real commercial data)
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.pem
!tests/fixtures/**/*.key
!backend/tests/fixtures/**/*.csv
!backend/tests/fixtures/**/*.xlsx
!backend/tests/fixtures/**/*.db
!backend/tests/fixtures/**/*.sqlite
!backend/tests/fixtures/**/*.sqlite3
!backend/tests/fixtures/**/*.pem
!backend/tests/fixtures/**/*.key

# Logs, temporary files and disposable QA output
logs/
*.log
temp/
tmp/
*.tmp
/artifacts/qa/
/backend/.test-tmp/
/backend/.desktop-test-tmp/
/backend/.test-pytest-final/
/backend/.phase22-*/
/backend/.phase23-*/
/backend/.phase24-*
/backend/.phase31-*/
/backend/.phase32-*/

# Inactive SaaS tools: generated/private state only, never source or migrations
/supabase/.temp/
/supabase/.branches/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
