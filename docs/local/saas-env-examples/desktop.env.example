.

# SDR: provider/modelo configurados pelo operador
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=gpt-5.6-terra

# Ollama local (sem AI_API_KEY). Para OpenAI: AI_PROVIDER=openai e configure chave/modelo.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# SDR Inteligente: AI_PROVIDER=groq; modelo disponível na sua conta com JSON mode.
GROQ_API_KEY=
# Exemplo com JSON mode; confirme acesso e cota no projeto Groq.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60
