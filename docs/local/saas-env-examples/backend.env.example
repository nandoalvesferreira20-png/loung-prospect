LOUNG_STORAGE_BACKEND=postgres
LOUNG_ENABLE_WRITES=0
LOUNG_POSTGRES_DSN=
SUPABASE_URL=
SUPABASE_AUTH_AUDIENCE=authenticated
# Operator-only migration connection, never used by API:
LOUNG_MIGRATION_DSN=
GOOGLE_PLACES_API_KEY=
GROQ_API_KEY=
# JSON-mode example; confirm this model is enabled for your Groq project.
GROQ_MODEL=openai/gpt-oss-20b
# SQLite is opt-in and intended only for isolated legacy development:
# LOUNG_STORAGE_BACKEND=sqlite
# LOUNG_DATABASE_PATH=path/to/test-copy.db
